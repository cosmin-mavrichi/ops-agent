# Copy this file to .env (same folder, the repo root) and fill in what you use. .env is gitignored: it never gets
# committed, and only the agent evals (pnpm eval) read it. Never put a key in this example file.

# Where the eval's agent and judge run (default: claude-code):
#   claude-code  headless Claude Code on your own login (your subscription); needs no key
#   anthropic    the Claude API; needs ANTHROPIC_API_KEY
#   deepseek     DeepSeek's Anthropic-format API; needs DEEPSEEK_API_KEY
EVAL_BACKEND=claude-code

# API keys, only for the backend you picked.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional: models (defaults: claude-haiku-5-5; deepseek-flash on deepseek). The judge defaults to the agent's model.
# EVAL_MODEL=
# EVAL_JUDGE_MODEL=
